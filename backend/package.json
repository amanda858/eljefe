{
    "name": "eljefe-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:boot": "npm run prisma:bootstrap && npm run dev",
        "build": "tsc -p tsconfig.json",
        "test": "tsx --test tests/**/*.test.ts",
        "start": "node dist/index.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:seed": "tsx prisma/seed.ts",
        "prisma:bootstrap": "npm run prisma:generate && npm run prisma:deploy && tsx prisma/bootstrap.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.6.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "prisma": "^6.6.0",
        "tsx": "^4.19.3",
        "typescript": "^5.9.3"
    }
}